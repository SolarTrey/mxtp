<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="8dp">
    <ImageView android:id="@+id/w_art" android:layout_width="48dp" android:layout_height="48dp"
        android:scaleType="centerCrop" android:src="@drawable/ic_note" android:background="#22272E"
        android:contentDescription="Album art" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="mxtp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
            android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Nothing playing" android:textColor="#9AA3AD" android:textSize="12sp"
            android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/w_like" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
        android:src="@drawable/ic_heart_outline" android:contentDescription="Like" />
    <ImageView android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
        android:src="@drawable/ic_prev" android:contentDescription="Previous" />
    <ImageView android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
        android:background="@drawable/play_bg" android:src="@drawable/ic_play" android:contentDescription="Play or pause" />
    <ImageView android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
        android:src="@drawable/ic_next" android:contentDescription="Next" />
</LinearLayout>
